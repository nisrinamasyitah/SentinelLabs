DATABASE_URL="postgresql://sentinel:sentinel@localhost:5432/sentinel_labs"
JWT_SECRET="change-me-to-a-long-random-string"
CLIENT_ORIGIN="http://localhost:5173"
PORT=4000

# Optional: leave unset to use the dev fallback (magic links are logged to the
# server console and returned in the API response instead of emailed).
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=your-api-key
# SMTP_FROM="Sentinel Labs <noreply@yourdomain.com>"

# Optional: where contact-form submissions get emailed. Leave unset to only
# save them to the database (still visible via prisma studio).
# CONTACT_INBOX=you@yourdomain.com
